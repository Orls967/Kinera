{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinera.dev/schemas/1.0.0/vehicle-configuration.schema.json",
  "title": "KINERA VehicleConfiguration Schema",
  "description": "Schema for canonical KINERA V1 multi-configuration vehicle topologies and SI specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "code",
    "name",
    "powertrainType",
    "drivetrainLayout",
    "specification",
    "powertrain",
    "topology",
    "componentIds",
    "supportedDiffModes",
    "supportedSimulationModules",
    "rootAssemblyAssetId"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/CanonicalId",
      "enum": [
        "vehicle.config.ice-fwd",
        "vehicle.config.ice-rwd",
        "vehicle.config.ice-awd",
        "vehicle.config.ice-4wd",
        "vehicle.config.ev-fwd",
        "vehicle.config.ev-rwd",
        "vehicle.config.ev-dual-awd"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "code": {
      "type": "string",
      "enum": ["ICE-FWD", "ICE-RWD", "ICE-AWD", "ICE-4WD", "EV-FWD", "EV-RWD", "EV-DUAL-AWD"]
    },
    "name": { "type": "string", "minLength": 3 },
    "powertrainType": { "type": "string", "enum": ["ice", "ev"] },
    "drivetrainLayout": { "type": "string", "enum": ["fwd", "rwd", "awd", "4wd", "dual-awd"] },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "massKg",
        "wheelbaseM",
        "trackWidthM",
        "cgHeightM",
        "cgToFrontAxleM",
        "cgToRearAxleM",
        "yawInertiaKgM2",
        "dragCoefficient",
        "frontalAreaM2",
        "rollingResistanceCoeff",
        "tireEffectiveRadiusM",
        "frontAxleCorneringStiffnessNPerRad",
        "rearAxleCorneringStiffnessNPerRad"
      ],
      "properties": {
        "massKg": { "type": "number", "minimum": 100, "maximum": 50000 },
        "wheelbaseM": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 10.0 },
        "trackWidthM": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 4.0 },
        "cgHeightM": { "type": "number", "exclusiveMinimum": 0.1, "maximum": 2.5 },
        "cgToFrontAxleM": { "type": "number", "exclusiveMinimum": 0.1 },
        "cgToRearAxleM": { "type": "number", "exclusiveMinimum": 0.1 },
        "yawInertiaKgM2": { "type": "number", "exclusiveMinimum": 100 },
        "dragCoefficient": { "type": "number", "minimum": 0.1, "maximum": 1.5 },
        "frontalAreaM2": { "type": "number", "minimum": 0.5, "maximum": 12.0 },
        "rollingResistanceCoeff": { "type": "number", "minimum": 0.002, "maximum": 0.1 },
        "tireEffectiveRadiusM": { "type": "number", "minimum": 0.15, "maximum": 0.8 },
        "frontAxleCorneringStiffnessNPerRad": { "type": "number", "exclusiveMinimum": 5000 },
        "rearAxleCorneringStiffnessNPerRad": { "type": "number", "exclusiveMinimum": 5000 }
      }
    },
    "powertrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "propulsionKind",
        "engineModelId",
        "motorModelIds",
        "transmissionModelId",
        "differentialModelIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/CanonicalId" },
        "propulsionKind": { "type": "string", "enum": ["ice", "ev_single", "ev_dual"] },
        "engineModelId": { "oneOf": [{ "$ref": "#/$defs/CanonicalId" }, { "type": "null" }] },
        "motorModelIds": { "type": "array", "items": { "$ref": "#/$defs/CanonicalId" } },
        "transmissionModelId": { "$ref": "#/$defs/CanonicalId" },
        "differentialModelIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CanonicalId" }
        },
        "batteryCapacityJ": { "type": ["number", "null"], "minimum": 0 },
        "nominalVoltageV": { "type": ["number", "null"], "minimum": 48, "maximum": 1200 },
        "internalResistanceOhm": { "type": ["number", "null"], "minimum": 0 },
        "inverterEfficiency": { "type": ["number", "null"], "exclusiveMinimum": 0.05, "maximum": 1.0 }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "drivenAxles",
        "steeredAxles",
        "hasMechanicalCenterCoupling",
        "hasLowRangeTransferCase",
        "paths"
      ],
      "properties": {
        "placement": {
          "type": "string",
          "enum": ["front-transverse", "front-longitudinal", "rear-axle", "dual-axle"]
        },
        "drivenAxles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["front", "rear"] }
        },
        "steeredAxles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["front"] }
        },
        "hasMechanicalCenterCoupling": { "type": "boolean" },
        "hasLowRangeTransferCase": { "type": "boolean" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "axleTarget", "orderedComponentIds", "stageEfficiencies"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "axleTarget": { "type": "string", "enum": ["front", "rear"] },
              "orderedComponentIds": {
                "type": "array",
                "minItems": 2,
                "items": { "$ref": "#/$defs/CanonicalId" }
              },
              "stageEfficiencies": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "exclusiveMinimum": 0.05, "maximum": 1.0 }
              }
            }
          }
        }
      }
    },
    "componentIds": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/CanonicalId" }
    },
    "supportedDiffModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["open", "lsd", "locked", "center_diff", "ev_electronic"]
      }
    },
    "supportedSimulationModules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["powertrain", "dynamics", "comparison"] }
    },
    "rootAssemblyAssetId": { "$ref": "#/$defs/CanonicalId" },
    "architecturalVariations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "CanonicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,4}$"
    }
  }
}
